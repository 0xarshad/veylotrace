# VeyloTrace backend configuration. Copy to .env (or run `python scripts/init_env.py`, which also
# generates the two secrets below). Placeholder values here are NOT secrets; never commit a real .env.

APP_ENV=development                     # development | production
# Defaults to backend/data/veylotrace.db. PostgreSQL later: postgresql+psycopg://user:pass@host/dbname
# DATABASE_URL=sqlite:////absolute/path/to/veylotrace.db

# --- secrets (generate!) ---
JWT_SECRET=                             # >= 32 random chars (init_env.py makes 64+)
ENCRYPTION_KEY=                         # Fernet key; encrypts AI provider credentials at rest

# --- tokens ---
JWT_ISSUER=veylotrace
JWT_AUDIENCE=veylotrace-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
SESSION_ABSOLUTE_DAYS=60

# --- web ---
CORS_ORIGINS=http://localhost:5173      # comma separated allowlist
FRONTEND_URL=http://localhost:5173      # used in email links
COOKIE_SECURE=false                     # MUST be true in production (HTTPS)
COOKIE_SAMESITE=strict

# --- email (verification + password reset) ---
EMAIL_BACKEND=file                      # file (writes to data/outbox, dev only) | smtp
# Email verification is required automatically once EMAIL_BACKEND=smtp. Leave unset for local use
# (accounts are verified on sign-up); set true/false to force it either way.
# REQUIRE_EMAIL_VERIFICATION=true
EMAIL_FROM=VeyloTrace <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- rate limiting ---
LOGIN_RATE_LIMIT=5                      # attempts per window per (ip, email)
LOGIN_RATE_WINDOW_SECONDS=300
GENERAL_RATE_LIMIT_PER_MINUTE=600

# --- backups ---
# BACKUP_DIR=/absolute/path/to/backups   # default: backend/data/backups
BACKUP_RETENTION=14
AUTO_BACKUP_HOURS=0                     # 0 = off; e.g. 24 for a daily scheduled backup
BACKUP_PASSPHRASE=                      # set to encrypt backups at rest (keep it safe: needed to restore!)

# --- AI ---
AI_REQUEST_TIMEOUT_SECONDS=60
